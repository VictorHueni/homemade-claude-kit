      "requiredRoles": [
        "--dark-canvas-bg",
        "--dark-surface",
        "--dark-border",
        "--dark-ink",
        "--dark-muted",
        "--dark-accent",
        "--dark-accent-ink",
        "--dark-slide-bg",
        "--dark-slide-fg"
