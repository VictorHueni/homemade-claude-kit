        {
          "fg": [
            "--dark-accent-ink",
            "--dark-ink"
          ],
          "bg": "--dark-info",
          "use": "On dark: text on an info fill (planned badge)"
        },
        {
          "fg": [
            "--dark-accent-ink",
            "--dark-ink"
          ],
          "bg": "--dark-warning",
          "use": "On dark: text on a warning fill (high-pain badge)"
        },
        {
          "fg": [
            "--dark-accent-ink",
            "--dark-ink"
          ],
          "bg": "--dark-danger",
          "use": "On dark: text on a danger fill"
        },
        {
          "fg": [
            "--dark-accent-ink",
            "--dark-ink"
          ],
          "bg": "--dark-muted",
          "use": "On dark: text on a muted fill (backlog badge)"
        },
        {
          "fg": [
            "--dark-accent-ink",
            "--dark-ink"
          ],
          "bg": "--dark-chart-1",
          "use": "On dark: text on the first chart step (differentiator, validated)"
        },
        {
          "fg": [
            "--dark-accent-ink",
            "--dark-ink"
          ],
          "bg": "--dark-chart-2",
          "use": "On dark: text on the second chart step (necessary, tested)"
        },
        {
          "fg": [
            "--dark-accent-ink",
            "--dark-ink"
          ],
          "bg": "--dark-chart-3",
          "use": "On dark: text on the third chart step (commodity, assumed)"
        },
        {
          "fg": "--dark-ink",
          "bg": "--dark-key-base",
          "use": "Text on the key element of a dark slide"
        },
        {
          "fg": "--dark-accent-text",
          "bg": "--dark-canvas-bg",
          "use": "Highlighted text on a dark page"
        },
        {
          "fg": "--dark-accent-text",
          "bg": "--dark-surface",
          "use": "Highlighted text on a dark card"
        }
      ]
