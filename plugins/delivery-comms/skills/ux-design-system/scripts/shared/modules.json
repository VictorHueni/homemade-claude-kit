      "classes": [
        "dark",
        "dark-key",
        "dark-accent"
      ],
      "pairs": [
        {
          "fg": "--dark-ink",
          "bg": "--dark-canvas-bg",
          "use": "On dark: body text on the page"
        },
        {
          "fg": "--dark-ink",
          "bg": "--dark-surface",
          "use": "On dark: body text on cards"
        },
        {
          "fg": "--dark-tertiary",
          "bg": "--dark-canvas-bg",
          "use": "On dark: footers, legal lines and slide numbers on the page"
        },
        {
          "fg": "--dark-muted",
          "bg": "--dark-surface",
          "use": "On dark: secondary text on cards"
        },
        {
          "fg": "--dark-accent-ink",
          "bg": "--dark-accent",
          "use": "On dark: text on accent fills"
        },
        {
          "fg": "--dark-accent",
          "bg": "--dark-surface",
          "use": "On dark: links and IDs on cards"
        },
        {
          "fg": [
            "--dark-accent-ink",
            "--dark-ink"
