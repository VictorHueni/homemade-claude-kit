        "--dark-danger": "On dark: negative, error, critical",
        "--dark-info": "On dark: informational, planned, neutral-active",
        "--dark-shadow": "On dark: card elevation",
        "--dark-chart-1": "On dark: first series",
        "--dark-chart-2": "On dark: second series",
        "--dark-chart-3": "On dark: third series",
        "--dark-chart-4": "On dark: fourth series",
        "--dark-chart-rest": "On dark: every series past the fourth",
        "--dark-chart-axis": "On dark: axis and baseline",
        "--dark-chart-grid": "On dark: gridlines",
        "--dark-chart-highlight": "On dark: highlighted mark",
        "--dark-slide-bg": "On dark: slide background",
        "--dark-slide-fg": "On dark: slide text colour",
