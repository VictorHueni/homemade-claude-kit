<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{TITLE}}</title>
<style>
/* ===== 1. Design CSS (contract roles), then the viz domain colours (--kit-*) ===== */
{{DESIGN_SYSTEM_CSS}}

/* ===== 2. Baseline layout (contract roles and --kit-* only; never hard-codes colour) ===== */
/* Views are dashboard-density surfaces: the title reads the renderer's own
   --kit-viz-title-size, not the deck-scaled --title-size. */
:root { --kit-viz-title-size: 0.95rem; }
* { box-sizing: border-box; }
html, body { margin: 0; padding: 0; }
body {
  font-family: var(--font-body);
  color: var(--ink);
  background: var(--canvas-bg);
  line-height: 1.35;
}
.viz-shell { max-width: var(--shell-max); margin: 0 auto; padding: 0.75rem 1rem; }
.viz-header { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.6rem; margin-bottom: 0.1rem; }
.viz-title { font-family: var(--font-heading);
             font-size: var(--kit-viz-title-size); font-weight: 600; margin: 0; }
.viz-kind  { font-family: var(--font-mono); font-size: 0.58rem; text-transform: uppercase;
             letter-spacing: 0.08em; color: var(--muted); border: 1px solid var(--border);
             padding: 0.08rem 0.4rem; border-radius: 999px; }
.viz-meta  { font-size: 0.68rem; color: var(--muted); margin: 0 0 0.5rem; }
.viz-toolbar { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-bottom: 0.5rem; }
.viz-btn {
  font: inherit; font-family: var(--font-heading); font-size: 0.68rem; cursor: pointer;
  background: var(--surface); color: var(--ink);
  border: 1px solid var(--border); border-radius: var(--btn-radius);
  padding: 0.2rem 0.5rem; transition: background .12s ease, border-color .12s ease;
}
.viz-btn:hover { border-color: var(--accent); }
.viz-btn[aria-pressed="true"] { background: var(--accent); color: var(--accent-ink); border-color: var(--accent); }
.viz-empty { color: var(--muted); font-style: italic; padding: 2rem 0; }
.viz-footer { margin-top: 0.9rem; font-size: 0.58rem; color: var(--muted);
              border-top: 1px solid var(--border); padding-top: 0.5rem; }

/* ===== 3. View-specific CSS (emitted by the renderer) ===== */
{{VIEW_CSS}}
</style>
</head>
<body>
<div class="viz-shell">
  <header class="viz-header">
    <h1 class="viz-title">{{TITLE}}</h1>
    <span class="viz-kind">{{KIND}}</span>
  </header>
  <p class="viz-meta">{{META}}</p>
  <div class="viz-toolbar">{{TOOLBAR}}</div>
  <main class="viz-content">
{{CONTENT}}
  </main>
  <footer class="viz-footer">{{FOOTER}}</footer>
</div>
<script>
{{RUNTIME_JS}}
</script>
</body>
</html>
